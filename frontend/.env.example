# PortOne(PG) 브라우저 결제창 연동에 쓰는 값. storeId·channelKey는 비밀값이 아니라 클라이언트에 노출돼도 된다.
# 실제 값은 팀 채널에서 개별 전달받아 .env 에만 넣는다.
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=

# Cloudinary unsigned 업로드(대표 이미지). 값이 없으면 파일 업로드 버튼이 숨고 주소 입력만 남는다.
# 이 두 값은 번들에 노출되는 것이 정상이다 - API Secret 은 절대 여기 넣지 않는다.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# 구글 소셜 로그인 클라이언트 ID(웹 애플리케이션). 공개돼도 되는 값이며, 없으면 구글 로그인 버튼이 숨는다.
# Google Cloud Console → 사용자 인증 정보 → OAuth 클라이언트 ID(웹)에서 발급하고,
# 승인된 JavaScript 원본에 http://localhost:5173 과 https://expohub.duckdns.org 을 등록한다.
VITE_GOOGLE_CLIENT_ID=

# 네이버 소셜 로그인 클라이언트 ID. 공개돼도 되는 값이며, 없으면 네이버 로그인 버튼이 숨는다.
# 네이버 개발자센터(developers.naver.com) → 애플리케이션 등록에서 발급하고,
# 서비스 URL에 http://localhost:5173, https://expohub.duckdns.org 을,
# Callback URL에 http://localhost:5173/auth/naver/callback, https://expohub.duckdns.org/auth/naver/callback 을 등록한다.
VITE_NAVER_CLIENT_ID=

# 카카오 소셜 로그인 REST API 키(인가 URL의 client_id). 공개돼도 되는 값이며, 없으면 카카오 로그인 버튼이 숨는다.
# 카카오 개발자(developers.kakao.com) → 내 애플리케이션 → 앱 키의 REST API 키.
# 카카오 로그인을 활성화하고, Redirect URI에 http://localhost:5173/auth/kakao/callback,
# https://expohub.duckdns.org/auth/kakao/callback 을 등록한다.
# 동의항목은 "프로필 정보(닉네임)"만 있으면 된다. 이메일은 비즈앱이라야 받을 수 있어
# 방안 B로 처리한다 — 이메일이 없으면 서버가 kakao_{id}@social.expohub.local placeholder 로 로그인시킨다.
# 백엔드도 같은 값을 KAKAO_REST_API_KEY 로 받아 토큰 교환에 쓴다.
VITE_KAKAO_REST_KEY=
