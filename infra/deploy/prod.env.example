# EC2 의 ~/fpt1/.env 로 복사해서 값을 채운다. 이 파일 외에 실제 값은 절대 커밋하지 않는다.

DB_ROOT_PASSWORD=
# 모든 서비스가 같은 값을 써야 한다 (identity 가 서명, 나머지가 검증)
JWT_SECRET=
INTERNAL_TOKEN=

# 최초 기동 시 Flyway 가 전체관리자 계정을 시드한다.
# bcrypt 해시에는 $ 가 들어가므로 반드시 작은따옴표로 감싼다.
SUPER_ADMIN_EMAIL=admin@team1.local
SUPER_ADMIN_PASSWORD_HASH=''

# 외부에서 접속하는 주소 (예: https://expohub.duckdns.org)
APP_BASE_URL=

# PortOne (PG) — 팀에 발급된 테스트 채널 키. 실제 돈은 나가지 않는다.
# 예약·박람회 서비스는 기본으로 portone-live 프로필(실제 PortOne API 조회)로 뜬다.
# 결제 확인 없이 mock 으로 돌려야 할 때만 아래 주석을 풀어 prod 만 남긴다(운영 비권장).
# PAYMENT_SERVICE_PROFILES=prod
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# 자연어 검색·태깅·체크인 요약이 쓰는 Gemini 키. 비워 두면 AI 기능만 빠지고 서비스는 뜬다
GEMINI_API_KEY=

# 쓸 Gemini 모델. 비워 두면 gemini-flash-latest 를 쓴다.
# 그 별칭은 최신 Flash 를 가리켜 무료 한도에서 가장 붐빈다 - 503·429 가 잦으면
# 여기에 구체적 모델명을 적고 재배포 없이 컨테이너만 다시 올리면 된다.
GEMINI_MODEL=

# 구글 소셜 로그인 - 프론트가 넘긴 액세스 토큰이 우리 앱에 발급된 것인지(aud) 백엔드가 확인한다.
# GitHub Variables 의 VITE_GOOGLE_CLIENT_ID 와 같은 값. 비어 있으면 구글 로그인만 동작하지 않는다.
GOOGLE_CLIENT_ID=

# 카카오 소셜 로그인 - 인가 코드를 토큰으로 교환할 때 쓰는 REST API 키(백엔드).
# 카카오 개발자 콘솔 → 앱 → 앱 키 → REST API 키. 비어 있으면 카카오 로그인만 동작하지 않는다.
KAKAO_REST_API_KEY=

# 카카오 REST 키에 클라이언트 시크릿이 켜져 있으면 그 값도 넣는다(콘솔: 앱 > 플랫폼 키 > REST API 키 > 클라이언트 시크릿).
KAKAO_CLIENT_SECRET=

# 네이버 소셜 로그인 - 인가 코드를 토큰으로 교환할 때 쓰는 Client ID/Secret(백엔드).
# 네이버 개발자센터 → 애플리케이션 → 개요에서 확인. VITE_NAVER_CLIENT_ID(프론트)와 같은 앱.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 이미지 업로드(Cloudinary unsigned) - 로컬에서 compose 로 web 을 빌드할 때만 쓴다.
# CD 는 GitHub Variables 의 VITE_CLOUDINARY_* 로 빌드하므로 서버 .env 에는 없어도 된다.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
